POSTGRES_USER=selector_drift
POSTGRES_DB=selector_drift
# Required -- docker-compose.yml fails closed (":?") if POSTGRES_PASSWORD is unset, rather
# than silently defaulting. This placeholder is fine for local dev only; never reuse it
# anywhere real credentials matter.
POSTGRES_PASSWORD=changeme_local_dev_only

# Integration tests (pytest -m integration) refuse to run unless SD_DATABASE_URL names a
# database whose name ends in "_test" -- see tests/conftest.py. Create it once against the
# running compose Postgres (`CREATE DATABASE selector_drift_test OWNER selector_drift;`), run
# `alembic upgrade head` against it, then export:
# SD_DATABASE_URL=postgresql+psycopg://selector_drift:changeme_local_dev_only@127.0.0.1:5432/selector_drift_test

# selector_drift settings (Task 5). The worker container gets SD_DATABASE_URL from compose
# (Task 6); for a local `uv run`, export it yourself -- no process reads this file for you.
SD_ENV=development
SD_DATABASE_URL=
SD_SPEC_DIR=specs
SD_SCOPE_DIR=scopes           # tests point this at a tmp copy; production never changes it
SD_EVIDENCE_ROOT=/data/evidence
SD_LAKE_ROOT=/data/lake
SD_SESSION_DIR=/data/sessions
SD_ESCALATION_CORPUS=/data/corpus/escalations   # rung 5's metadata-only cases; a mounted volume
SD_REDACTION_DEADLINE_S=60   # evidence redaction past this is refused (Task 33)
SD_REDACTION_KEY=          # REQUIRED; generate: python -c "import secrets; print(secrets.token_hex(32))". The worker and the bench-scorer must hold the SAME value.
# Rotating SD_REDACTION_KEY while heals are pending records them once as `unscorable`, never
# re-judged (about a day of exposure). Rotate right after a scoring run.
# bench-scorer: alembic 0002 creates the sd_scorer role with NO password. Deploy, in order:
#  1. Generate SD_SCORER_PASSWORD (below) and put it in .env.
#  2. alembic upgrade head
#  3. Create the evidence directory the read-only subpath mount needs:
#       docker compose run --rm --no-deps worker mkdir -p /data/evidence
#  4. Set the role's password ONCE per database. Load .env first, or the variables are empty.
#     SET log_min_error_statement stops a failed ALTER (e.g. no role yet) logging the password.
#       set -a; . ./.env; set +a
#       : "${SD_SCORER_PASSWORD:?set SD_SCORER_PASSWORD first}"
#       printf '%s\n' "SET log_min_error_statement = panic;" \
#         "ALTER ROLE sd_scorer PASSWORD :'pw';" | docker compose exec -T postgres \
#         psql -U "$POSTGRES_USER" -d "${POSTGRES_DB:-selector_drift}" -v pw="$SD_SCORER_PASSWORD"
#  5. docker compose up -d bench-scorer
#  6. docker compose logs --tail=20 bench-scorer
#     It must show Prefect serving the `bench-scorer` deployment and no `ScorerNotReady`.
SD_SCORER_PASSWORD=        # generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# worker: alembic 0003 creates the sd_worker role with NO password, and the compose worker
# connects as it (never as POSTGRES_USER, whose credential a renderer compromise must not reach).
# It can read and append to audit_log, and nothing else. Same one-time step as the scorer's,
# after `alembic upgrade head` and before `docker compose up -d worker`:
#       set -a; . ./.env; set +a
#       : "${SD_WORKER_PASSWORD:?set SD_WORKER_PASSWORD first}"
#       printf '%s\n' "SET log_min_error_statement = panic;" \
#         "ALTER ROLE sd_worker PASSWORD :'pw';" | docker compose exec -T postgres \
#         psql -U "$POSTGRES_USER" -d "${POSTGRES_DB:-selector_drift}" -v pw="$SD_WORKER_PASSWORD"
# Run `alembic upgrade head` as POSTGRES_USER from the host, never from the worker container.
SD_WORKER_PASSWORD=        # generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SD_WEB_ORIGIN=http://localhost:3000
SD_PUBLIC_BASE_URL=
SD_FIXTURE_MODE=0
# The one alert channel (Task 6, M2). Empty means every alert is logged as NOT SENT.
SD_ALERT_WEBHOOK_URL=
# Deploy history for the control arm (Task 29A, M10).
SD_DEPLOYS_FILE=deploys.yaml
SD_GITHUB_TOKEN=           # optional; fine-grained, read-only deployments, for gh-actions feeds
# Credentials (Task 32; docs/security.md). Session injection (SD_SESSION_DIR) is the default
# offer. Only for a target whose scope record says credential_posture: encrypted_store --
# the last resort, refused until the client's signed acknowledgement is recorded:
SD_CREDENTIAL_STORE=/data/credentials
SD_CREDENTIAL_KEK=         # 64 hex chars; generate: python -c "import secrets; print(secrets.token_hex(32))"
# Only for a target whose scope record says credential_posture: client_broker -- one pair per
# target, named after it (claims-portal -> CLAIMS_PORTAL). An https URL with no query string;
# the token is sent in the Authorization header only. Set real values in the VM's .env only.
# SD_BROKER_URL_CLAIMS_PORTAL=
# SD_BROKER_TOKEN_CLAIMS_PORTAL=

# Test bench (Task 12). Set real values in the VM's .env only -- never in the repo.
# Generate each with: python -c "import secrets; print(secrets.token_hex(32))"
TESTBENCH_SESSION_SECRET=
TESTBENCH_OVERRIDE_SECRET=
# The bench's public host name; must match the single origin in scopes/testbench.yaml.
BENCH_HOST=
