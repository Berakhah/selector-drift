POSTGRES_USER=selector_drift
POSTGRES_DB=selector_drift
# Required -- docker-compose.yml fails closed (":?") if POSTGRES_PASSWORD is unset, rather
# than silently defaulting. This placeholder is fine for local dev only; never reuse it
# anywhere real credentials matter.
POSTGRES_PASSWORD=changeme_local_dev_only

# Integration tests (pytest -m integration) refuse to run unless SD_DATABASE_URL names a
# database whose name ends in "_test" -- see tests/conftest.py. Create it once against the
# running compose Postgres (`CREATE DATABASE selector_drift_test OWNER selector_drift;`), run
# `alembic upgrade head` against it, then export:
# SD_DATABASE_URL=postgresql+psycopg://selector_drift:changeme_local_dev_only@127.0.0.1:5432/selector_drift_test
