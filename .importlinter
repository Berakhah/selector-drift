[importlinter]
# NOTE: import-linter 2.14's ini reader only splits a value into a list on embedded
# newlines, never on commas (see importlinter.adapters.user_options._clean_section_config).
# The plan text's single-line `root_packages = selector_drift, testbench` is therefore
# parsed as one literal package name ("selector_drift, testbench") and iterating over that
# string yields individual characters -- reproduced as `Could not find package 's'`. Same
# two root packages, syntax the installed version actually accepts.
root_packages =
    selector_drift
    testbench
# Keeps third-party packages (bok_core included) in the graph, so a future contract naming an
# external module matches real imports instead of reporting "kept" over an empty graph.
include_external_packages = True

[importlinter:contract:resolver-cannot-write]
name = A resolver cannot write
type = forbidden
source_modules = selector_drift.resolve
forbidden_modules = selector_drift.land

[importlinter:contract:judged-cannot-call-judge]
name = The judged cannot call the judge
type = forbidden
source_modules = selector_drift.resolve
forbidden_modules = selector_drift.validate

[importlinter:contract:heallog-cannot-refetch]
name = Replay uses stored evidence, never a live page
type = forbidden
source_modules = selector_drift.heallog
forbidden_modules = selector_drift.browser
# NB (C6): forbidden contracts report INDIRECT imports by default. Task 19's replay imports
# resolve.cascade, so this contract only holds because Task 13 moves PageSource out of browser/
# into resolve/page.py. Do not add allow_indirect_imports to make this pass — that would be
# suppressing the finding rather than fixing it.

[importlinter:contract:judge-reaches-rungs-only-by-protocol]
name = validate/ may reach rungs only via the public Rung protocol
type = forbidden
source_modules = selector_drift.validate
forbidden_modules = selector_drift.resolve.rungs
# Design 3.4 claims this contract; without this stanza it was never implemented (M22).
# Concrete rungs are constructed in orchestrate/ and injected; validate/ sees only Rung + Family.

[importlinter:contract:answer-key-isolation]
name = The product cannot see the bench -- the answer key or anything else in testbench
type = forbidden
source_modules = selector_drift
forbidden_modules = testbench
# Widened 2026-09-26 from testbench.answers (bench spec §2): the product must not know it is
# being tested. Contract id unchanged so Task 1's test still finds it.

[importlinter:contract:bench-stands-alone]
name = The portal, the engine and the schedule do not import the product
type = forbidden
source_modules =
    testbench.portal
    testbench.mutations
    testbench.schedule
forbidden_modules = selector_drift

[importlinter:contract:only-the-scorer-reads-the-product]
name = Only testbench.score may import selector_drift.db
type = forbidden
source_modules = testbench
forbidden_modules = selector_drift.db
ignore_imports =
    testbench.score -> selector_drift.db.**
    testbench.score -> selector_drift.orchestrate.history
    testbench.score -> selector_drift.orchestrate.run_record
    testbench.score -> selector_drift.heallog.evidence
# Task 26C: the scorer imports selector_drift.db.session/models only, so the bare
# `-> selector_drift.db` ignore matched nothing; with unmatched-ignore alerting back on it went.
# Fix round 1 (I2): it reuses the product's own accepted-run predicate (orchestrate.history)
# and NO_TERMINAL_STATE (orchestrate.run_record) rather than re-deriving them; both reach
# selector_drift.db, so those two edges -- from testbench.score only -- are ignored here too.
# Fix round 2 (M1): it derives each bundle directory with heallog.evidence.heal_bundle_dir
# rather than trusting the stored uri; heallog.evidence reaches selector_drift.db as well.

[importlinter:contract:only-the-gate-mints]
name = Only scope.gate may reach the mint token
type = forbidden
source_modules =
    selector_drift.browser
    selector_drift.resolve
    selector_drift.validate
    selector_drift.extract
    selector_drift.land
    selector_drift.orchestrate
    selector_drift.heallog
    selector_drift.api
    selector_drift.credentials
forbidden_modules = selector_drift.scope._token
# Indirect imports are allowed ON PURPOSE (found 2026-09-26): orchestrate -> scope.gate ->
# scope._token is the one legitimate path, and forbidden contracts count indirect imports by
# default, so without this line the contract breaks on the only caller it exists to permit.
# What is forbidden is a DIRECT import of _token from any of these packages.
allow_indirect_imports = True

[importlinter:contract:validate-cannot-land]
name = The judge never writes the lake or the cache
type = forbidden
source_modules = selector_drift.validate
forbidden_modules =
    selector_drift.land
    selector_drift.orchestrate

# There is no no-model-calls contract here: the bok_core import allow-list is enforced by
# tests/test_bok_core_allowlist.py instead.

[importlinter:contract:only-orchestrate-writes-the-cache]
name = The selector cache is written only by orchestrate.cache_writer
type = forbidden
source_modules =
    selector_drift.resolve
    selector_drift.validate
    selector_drift.api
    selector_drift.heallog
    selector_drift.land
    selector_drift.quality
    selector_drift.extract
    selector_drift.browser
    selector_drift.scope
    selector_drift.spec
    selector_drift.credentials
    selector_drift.db
forbidden_modules =
    selector_drift.orchestrate.cache_writer
# Task 17 Step 8, landed with Task 26A. Widened from the plan's four source packages to every
# product package outside orchestrate/: none of them has a reason to hold the writer. Fix round
# 1 (M1) completed the list -- scope, spec, credentials and db were the packages still missing.
